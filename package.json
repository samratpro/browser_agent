{
    "name": "ai-browser-agent",
    "version": "1.0.0",
    "description": "Self-Learning AI Browser Automation System",
    "main": "out/main/index.js",
    "author": "Samrat",
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "build:exe": "npm run build && electron-builder",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@types/sql.js": "^1.4.9",
        "fuse.js": "^7.0.0",
        "node-cron": "^3.0.3",
        "openai": "^4.47.1",
        "playwright": "^1.44.0",
        "sql.js": "^1.14.0",
        "ts_playwright_browser_manager": "github:samratpro/ts_playwright_browser_manager",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@electron-toolkit/preload": "^3.0.0",
        "@electron-toolkit/utils": "^3.0.0",
        "@types/better-sqlite3": "^7.6.10",
        "@types/node": "^20.14.2",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "electron": "^40.6.1",
        "electron-builder": "^26.8.1",
        "electron-vite": "^5.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.24.0",
        "typescript": "^5.5.2",
        "vite": "^7.3.1"
    },
    "build": {
        "appId": "com.samrat.ai-browser-agent",
        "productName": "AI Browser Agent",
        "directories": {
            "output": "dist-electron"
        },
        "win": {
            "target": "nsis",
            "icon": "resources/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "resources/icon.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "resources/icon.png"
        },
        "files": [
            "out/**/*",
            "resources/**/*"
        ],
        "extraResources": [
            {
                "from": "node_modules/playwright/.local-browsers",
                "to": ".local-browsers"
            }
        ]
    },
    "keywords": [],
    "license": "ISC",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/samratpro/browser_agent.git"
    },
    "bugs": {
        "url": "https://github.com/samratpro/browser_agent/issues"
    },
    "homepage": "https://github.com/samratpro/browser_agent#readme"
}
